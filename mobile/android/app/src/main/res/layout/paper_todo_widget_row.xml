<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/widget_row_check" android:layout_width="40dp" android:layout_height="48dp" android:gravity="center" android:textSize="24sp" android:textColor="#3575F0" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
        <TextView android:id="@+id/widget_row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_secondary" />
        <TextView android:id="@+id/widget_row_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" android:textColor="@color/widget_text" />
    </LinearLayout>
</LinearLayout>
